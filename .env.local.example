# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://lszwokdthvgzcjdlwxzp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key>
SUPABASE_SECRET_KEY=<service role key>

# ─── Google / Gmail ───────────────────────────────────────────────────────────
# Service account JSON for Gmail ingestion + Sheets/Drive integration.
# On Vercel: paste the full JSON string (or base64-encode it).
# Locally: set to the file path, e.g. /home/clawd/.openclaw/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=/home/clawd/.openclaw/google-service-account.json
GOOGLE_SHEET_ID=1FRxId1AfzQ-fAjiyPr_qc-Dv9hOsqkEJmb5TeH-Y3MA

# ─── Anthropic (AI extraction) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=<anthropic api key>

# ─── Filtro de Calidad — Mario Override Auth ─────────────────────────────────
# Bearer token for Mario-only override endpoints (/api/quality/override, /api/quality/ingest-emails)
# Generate: openssl rand -hex 32
MARIO_OVERRIDE_SECRET=<generate with: openssl rand -hex 32>

# Exposed to browser for /quality dashboard (internal admin only — do NOT expose externally)
NEXT_PUBLIC_MARIO_OVERRIDE_SECRET=<same value as MARIO_OVERRIDE_SECRET>

# ─── Face Match Provider (optional) ──────────────────────────────────────────
# Supported: "rekognition" | "azure" | "none" (default: "none" → manual review)
FACE_MATCH_PROVIDER=none
FACE_MATCH_THRESHOLD=0.92

# If FACE_MATCH_PROVIDER=rekognition:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<aws access key>
# AWS_SECRET_ACCESS_KEY=<aws secret key>

# If FACE_MATCH_PROVIDER=azure:
# AZURE_FACE_ENDPOINT=https://<region>.api.cognitive.microsoft.com
# AZURE_FACE_KEY=<azure cognitive key>
